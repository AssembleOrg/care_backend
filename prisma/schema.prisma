generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cuidador {
  id                String               @id @default(uuid())
  nombreCompleto    String
  dniEnc            String
  dniHash           String               @unique
  telefonoEnc       String?
  telefonoHash      String?              @unique
  emailEnc          String?
  emailHash         String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  asignaciones      AsignacionCuidador[]
  pagos             Pago[]
  personasAsistidas PersonaCuidador[]
  usuario           Usuario?
  fichajes          Fichaje[]
}

model PersonaAsistida {
  id                             String            @id @default(uuid())
  nombreCompleto                 String
  dniEnc                         String?
  dniHash                        String?           @unique
  telefonoEnc                    String?
  telefonoHash                   String?           @unique
  direccionEnc                   String?
  direccionHash                  String?
  telefonoContactoEmergenciaEnc  String?
  telefonoContactoEmergenciaHash String?
  // Punto exacto del domicilio donde se cuida a la persona. Se usa para
  // validar la distancia del fichaje del cuidador (presentismo).
  lat                            Float?
  lng                            Float?
  // Radio tolerado en metros para dar un fichaje por "en rango".
  radioMetros                    Int               @default(50)
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt
  asignaciones                   Asignacion[]
  pagos                          Pago[]
  cuidadores                     PersonaCuidador[]
  contratos                      Contrato[]
  fichajes                       Fichaje[]
}

model PersonaCuidador {
  id          String          @id @default(uuid())
  personaId   String
  cuidadorId  String
  fechaInicio DateTime        @default(now())
  fechaFin    DateTime?
  activo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  cuidador    Cuidador        @relation(fields: [cuidadorId], references: [id], onDelete: Cascade)
  persona     PersonaAsistida @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([personaId, cuidadorId, fechaInicio])
  @@index([personaId])
  @@index([cuidadorId])
}

model Asignacion {
  id                String               @id @default(uuid())
  personaId         String
  fechaInicio       DateTime
  fechaFin          DateTime?
  horarios          Json?                // Opcional: días de la semana (0-6)
  horasPorCuidador  Json?                // { cuidadorId: { horas: number, precioPorHora: number } }
  notas             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  persona           PersonaAsistida      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  cuidadores        AsignacionCuidador[]
  pagos             Pago[]
  fichajes          Fichaje[]
}

model AsignacionCuidador {
  id           String     @id @default(uuid())
  asignacionId String
  cuidadorId   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  asignacion   Asignacion @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  cuidador     Cuidador   @relation(fields: [cuidadorId], references: [id], onDelete: Cascade)

  @@unique([asignacionId, cuidadorId])
  @@index([asignacionId])
  @@index([cuidadorId])
}

model Pago {
  id              String           @id @default(uuid())
  cuidadorId      String
  personaId       String?
  asignacionId    String?
  monto           Decimal          @db.Decimal(10, 2)
  fecha           DateTime
  metodo          String            @default("LIQUIDACION")
  nota            String?
  precioPorHora   Decimal           @db.Decimal(10, 2)
  horasTrabajadas Decimal           @db.Decimal(10, 2)
  semanaInicio    DateTime
  semanaFin       DateTime
  horarios        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cuidador        Cuidador         @relation(fields: [cuidadorId], references: [id], onDelete: Cascade)
  persona         PersonaAsistida?  @relation(fields: [personaId], references: [id])
  asignacion      Asignacion?      @relation(fields: [asignacionId], references: [id], onDelete: SetNull)
  recibos         ReciboAdjunto[]
}

model ReciboAdjunto {
  id        String   @id @default(uuid())
  pagoId    String
  url       String
  filename  String
  createdAt DateTime @default(now())
  pago      Pago     @relation(fields: [pagoId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  table     String
  recordId  String
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contrato {
  id                     String           @id @default(uuid())
  idCliente              String?
  nombreManual           String?
  nombreManualHash       String?          @unique
  cuitManual             String?
  cuitManualHash         String?          @unique
  direccionManual        String?
  direccionManualHash    String?          @unique
  telefonoEmergencia     String?
  telefonoEmergenciaHash String?          @unique
  fechaInicio            DateTime
  fechaFin               DateTime
  createdAt              DateTime         @default(now())
  persona                PersonaAsistida? @relation(fields: [idCliente], references: [id])
}

enum EstadoSolicitud{
  ABIERTA
  RECIEN_RECIBIDA
  CERRADA
}

model SolicitudEmpleo{
  id                    String          @id @default(uuid())
  nombre                String
  apellido              String
  zonaTrabajo           String            //Zona donde desea trabajar
  telefono              String
  telefonoHash          String
  email                 String
  emailHash             String
  estado                EstadoSolicitud @default(ABIERTA)
  experiencia           String?         @db.VarChar(200)
  experienciaHash       String?
  cvUrl                 String?           //Path del CV en Supabase Storage
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([emailHash])
  @@index([telefonoHash])
}

model MensajeContacto{
  id          String   @id @default(uuid())
  nombre      String
  telefono    String?              //Encriptado
  email       String               //Encriptado
  mensaje     String   @db.Text    //Encriptado
  leido       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Registro de envíos de formularios públicos para rate limiting por IP (anti-spam).
// ipHash = hash de la IP (no se guarda la IP en claro). routeKey identifica el form.
model FormSubmissionLog {
  id        String   @id @default(uuid())
  routeKey  String   // 'solicitudes-empleo' | 'contacto'
  ipHash    String
  createdAt DateTime @default(now())

  @@index([routeKey, ipHash, createdAt])
}

enum RolUsuario {
  ADMIN
  CUIDADOR
}

// Espejo local de auth.users de Supabase: acá vive el rol y el bloqueo.
// `id` es el uid de Supabase Auth (no se genera acá). Un usuario CUIDADOR
// debería tener `cuidadorId` para poder fichar.
model Usuario {
  id                String     @id
  email             String     @unique
  nombre            String?
  rol               RolUsuario @default(CUIDADOR)
  activo            Boolean    @default(true)
  cuidadorId        String?    @unique
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  cuidador          Cuidador?  @relation(fields: [cuidadorId], references: [id], onDelete: SetNull)
  fichajes          Fichaje[]  @relation("FichajeUsuario")
  fichajesRevisados Fichaje[]  @relation("FichajeRevisor")

  @@index([rol])
}

enum EstadoRevisionFichaje {
  NO_REQUIERE // entrada y salida dentro del radio
  PENDIENTE   // alguna marca fuera de radio, esperando decisión del admin
  APROBADO
  RECHAZADO
}

// Un turno de trabajo: una fila por par entrada/salida. La salida se completa
// sobre la misma fila. Las distancias se calculan SIEMPRE en el servidor
// contra las coordenadas de la PersonaAsistida.
model Fichaje {
  id                String                @id @default(uuid())
  usuarioId         String
  cuidadorId        String
  personaId         String
  asignacionId      String?

  entradaAt         DateTime
  entradaLat        Float
  entradaLng        Float
  entradaPrecisionM Float?
  entradaDistanciaM Float
  entradaEnRango    Boolean

  salidaAt          DateTime?
  salidaLat         Float?
  salidaLng         Float?
  salidaPrecisionM  Float?
  salidaDistanciaM  Float?
  salidaEnRango     Boolean?

  revision          EstadoRevisionFichaje @default(NO_REQUIERE)
  revisadoPorId     String?
  revisadoAt        DateTime?
  notaRevision      String?

  userAgent         String?
  ipHash            String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  usuario           Usuario               @relation("FichajeUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  revisadoPor       Usuario?              @relation("FichajeRevisor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  cuidador          Cuidador              @relation(fields: [cuidadorId], references: [id], onDelete: Cascade)
  persona           PersonaAsistida       @relation(fields: [personaId], references: [id], onDelete: Cascade)
  asignacion        Asignacion?           @relation(fields: [asignacionId], references: [id], onDelete: SetNull)

  @@index([cuidadorId, entradaAt])
  @@index([personaId, entradaAt])
  @@index([usuarioId, entradaAt])
  @@index([revision])
}
